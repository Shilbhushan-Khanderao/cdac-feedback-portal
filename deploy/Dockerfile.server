# Build context: repo root (see docker-compose.yml). One lockfile at the root covers every workspace.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
RUN npm ci -w apps/api
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY apps/api/src/ apps/api/src/
RUN npm run build -w apps/api
# build copies migrations/*.sql; dev-only seed code must not ship
RUN rm -f apps/api/dist/db/seed.*

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
RUN npm ci -w apps/api --omit=dev && npm cache clean --force
COPY --from=builder /app/apps/api/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]
