# Build context: repo root. Builds the SPA and bakes it plus nginx.conf into the proxy image.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app
COPY package*.json tsconfig.json vite.config.ts index.html ./
COPY server/package.json server/package.json
RUN npm ci --no-audit --no-fund
COPY src/ ./src/
COPY public/ ./public/
RUN npm run build

FROM nginx:1.31.7-alpine@sha256:892bb2152464f0c5d8972593a5f5afaf8054552580b699d95f8ff4af08c2d33d
ARG SERVER_NAME=feedback.example.in
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/security-headers.conf /etc/nginx/security-headers.conf
RUN sed -i "s/__SERVER_NAME__/${SERVER_NAME}/g" /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
