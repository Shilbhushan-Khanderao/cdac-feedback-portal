# Copy to deploy/.env (never commit). Generate secrets with: openssl rand -hex 32
# Public hostname (baked into nginx.conf at image build) and URLs
SERVER_NAME=feedback.example.in
APP_URL=https://feedback.example.in
CORS_ORIGIN=https://feedback.example.in

# Postgres owner account (used by migrate and backup only)
POSTGRES_USER=cdac_owner
POSTGRES_PASSWORD=
POSTGRES_DB=cdac_feedback
# Password for the runtime role feedback_app (created/updated by migrate)
APP_DB_PASSWORD=

# API
NODE_ENV=production
COOKIE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_TTL_HOURS=24

# Backups
# Optional least-privilege backup role (INF-3): pg_dump only needs SELECT, not the superuser
# POSTGRES_USER it runs as by default. A DBA creates this role with a one-off, out-of-band
# GRANT (not run by this app, and not via a migration -- see DEPLOYMENT-CHECKLIST.md).
# Verified live (2026-10-20): without BYPASSRLS, pg_dump fails outright on RLS-protected
# tables ("query would be affected by row-level security policy") -- a plain SELECT grant is
# not enough and would otherwise risk a silently incomplete dump.
#   CREATE ROLE backup_reader LOGIN PASSWORD '...' BYPASSRLS;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO backup_reader;     -- includes `responses`,
#     which feedback_app itself cannot read -- pg_dump needs it, the app role must not.
#   GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO backup_reader; -- pg_dump reads sequence
#     state too; without this it fails on the first sequence it hits.
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO backup_reader;
# Leave both unset to keep today's behaviour (dumps run as POSTGRES_USER).
BACKUP_DB_ROLE=
BACKUP_DB_PASSWORD=
BACKUP_ENCRYPTION_KEY=
# Optional offsite copy after each backup, rsync over ssh, e.g. backup@10.0.0.5:/srv/cdac-backups/
# Add the private key as a read-only volume on the backup service (see docs/ops/PRODUCTION-CUTOVER-RUNBOOK.md).
BACKUP_OFFSITE_TARGET=
BACKUP_OFFSITE_SSH_KEY=/run/offsite_key
