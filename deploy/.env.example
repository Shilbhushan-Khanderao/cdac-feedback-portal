# Copy to deploy/.env (never commit). Generate secrets with: openssl rand -hex 32
# Public hostname (baked into nginx.conf at image build) and URLs
SERVER_NAME=feedback.example.in
APP_URL=https://feedback.example.in
CORS_ORIGIN=https://feedback.example.in

# Postgres owner account (used by migrate and backup only)
POSTGRES_USER=cdac_owner
POSTGRES_PASSWORD=
POSTGRES_DB=cdac_feedback
# Password for the runtime role feedback_app (created/updated by migrate)
APP_DB_PASSWORD=

# API
NODE_ENV=production
COOKIE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_TTL_HOURS=24

# Backups
BACKUP_ENCRYPTION_KEY=
# Optional offsite copy after each backup, rsync over ssh, e.g. backup@10.0.0.5:/srv/cdac-backups/
# Add the private key as a read-only volume on the backup service (see docs/ops/PRODUCTION-CUTOVER-RUNBOOK.md).
BACKUP_OFFSITE_TARGET=
BACKUP_OFFSITE_SSH_KEY=/run/offsite_key
