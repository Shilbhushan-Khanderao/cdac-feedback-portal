{
  "name": "cdac-feedback-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "description": "C-DAC module feedback portal: students submit, course coordinators schedule and report",
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "preview": "npm -w apps/web run preview",
    "test": "npm -w apps/web test",
    "server:dev": "npm -w apps/api run dev",
    "server:build": "npm -w apps/api run build",
    "server:test": "npm -w apps/api test",
    "db:init": "initdb -D .dev_db -U postgres -A trust",
    "db:start": "pg_ctl -D .dev_db -o \"-p 5433\" -l .dev_db/server.log start",
    "db:stop": "pg_ctl -D .dev_db stop",
    "test:load": "node tests/load/loadtest.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check *.json *.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
