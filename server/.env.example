# C-DAC Feedback Portal — Server Environment Variables
# Copy this file to .env and fill in real values before starting the server.
#
# To generate COOKIE_SECRET and BACKUP_ENCRYPTION_KEY:
#   openssl rand -hex 32

# ---------------------------------------------------------------- Required (no defaults)
# A cryptographically random string >= 32 characters. Server refuses to start without it.
COOKIE_SECRET=

# ---------------------------------------------------------------- Optional (defaults shown)
PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string. Update credentials for production.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/cdac_feedback

NODE_ENV=production

# The public URL of the frontend (used for OAuth redirect_uri and CORS).
CORS_ORIGIN=https://feedback.cdac.in
APP_URL=https://feedback.cdac.in

# ---------------------------------------------------------------- Google OAuth2 (required for production login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Session
# Hours before a session cookie expires (default 24).
SESSION_TTL_HOURS=24
