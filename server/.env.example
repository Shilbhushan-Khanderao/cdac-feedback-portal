# C-DAC Feedback Portal - Server Environment Variables
# Copy to .env (dev) or inject via the deployment env_file (production).
# Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------- Required everywhere (no defaults: server refuses to start)
# NODE_ENV has NO default. 'development' / 'test' enable /auth/dev-login; 'production' removes it.
NODE_ENV=development
COOKIE_SECRET=
# Connection as the NON-superuser app role `feedback_app` (created by the migration runner
# using APP_DB_PASSWORD). RLS is enforced for this role.
DATABASE_URL=postgresql://feedback_app:CHANGE_ME@localhost:5432/cdac_feedback

# ---------------------------------------------------------------- Required in production
# Owner/superuser. Used ONLY by `node dist/db/migrate.js` / bootstrap-admin / seed, never for requests.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cdac_feedback
# Password given to the feedback_app role when migrate creates/rotates it.
APP_DB_PASSWORD=CHANGE_ME
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public frontend URL (OAuth redirect_uri + CORS). Must be https:// in production.
APP_URL=https://feedback.cdac.in
CORS_ORIGIN=https://feedback.cdac.in

# ---------------------------------------------------------------- Optional
PORT=3000
HOST=0.0.0.0
SESSION_TTL_HOURS=24
# Comma separated proxies whose X-Forwarded-For is trusted. Default: loopback + private ranges (nginx).
# TRUST_PROXY=
# DB_POOL_MAX=20

# ---------------------------------------------------------------- Commands
#   npm run migrate            apply migrations (dev)    | prod: node dist/db/migrate.js
#   npm run seed               DEV/TEST ONLY fake data (refuses NODE_ENV=production)
#   node dist/db/bootstrap-admin.js <email> "<Full Name>"   create the first admin
